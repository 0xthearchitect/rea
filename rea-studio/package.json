{
  "name": "rea-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/build-bridge.mjs && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-bridge.mjs && tauri icon assets/icon.svg --output src-tauri/icons",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/verify-live.mjs",
    "test:native": "node scripts/native-e2e.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --features custom-protocol"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "cytoscape": "^3.33.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.8.4",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
